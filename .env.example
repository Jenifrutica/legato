# Variables del proyecto (copia a .env.local y rellena)
VITE_LOCAL_MODE=true

# Autenticación real con Firebase (recomendado). Si falta algo, la app cae
# automáticamente al modo local con cuentas en IndexedDB.
VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cognito (bloqueado por la SCP de AWS; se deja preparado)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# Fuentes de música
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173
VITE_JAMENDO_CLIENT_ID=
