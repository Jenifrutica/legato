# Variables del proyecto (copia a .env.local y rellena)
VITE_LOCAL_MODE=true

# Autenticación real con Firebase (Google + correo) y sincronización en la nube.
# Si falta algo, la app cae automáticamente al modo local (IndexedDB).
VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Fuentes de música
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173
VITE_JAMENDO_CLIENT_ID=
